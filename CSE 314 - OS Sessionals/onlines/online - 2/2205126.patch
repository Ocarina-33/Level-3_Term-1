diff --git a/user/limit.c b/user/limit.c
new file mode 100644
index 0000000..c148b29
--- /dev/null
+++ b/user/limit.c
@@ -0,0 +1,37 @@
+#include "kernel/param.h"
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+
+// Call getpid() five times, printing what each call returned.
+static void burst(char *who)
+{
+int i;
+for(i = 1; i <= 5; i++)
+printf("%s %d: getpid() = %d\n", who, i, getpid());
+}
+
+int main(int argc, char *argv[])
+{
+if(argc == 3){
+if(limit(atoi(argv[1]), atoi(argv[2])) < 0){
+    fprintf(2, "%s: limitsyscall failed\n", argv[0]);
+    exit(1);
+}
+
+}
+
+else if(argc != 1){
+    fprintf(2, "Usage: %s [syscall_num limit]\n", argv[0]);
+    exit(1);
+}
+burst("parent");
+if(fork() == 0){
+    burst("child ");
+    exit(0);
+}
+wait(0);
+
+exit(0);
+}
\ No newline at end of file
