 // An array mapping syscall numbers from syscall.h
 // to the function that handles the system call.
@@ -126,8 +127,60 @@ static uint64 (*syscalls[])(void) = {
 [SYS_link]    sys_link,
 [SYS_mkdir]   sys_mkdir,
 [SYS_close]   sys_close,
+[STS_limit]   sys_limit,
 };
 
+struct syscall_entry {
+  struct spinlock lock;
+  struct syscall_stat stat;
+};
+struct syscall_entry syscall_stats[NSYSCALL + 1];
+
+void
+syscallstatinit(void)
+{
+  for(int i = 1; i <= NSYSCALL; i++){
+    initlock(&syscall_stats[i].lock, "syscallstat");
+    safestrcpy(syscall_stats[i].stat.syscall_name, syscall_names[i],
+               sizeof(syscall_stats[i].stat.syscall_name));
+    syscall_stats[i].stat.limit = 0;
+  }
+}
+
+static void
+record_syscall_stat(int num)
+{
+  if(num <= 0 || num > NSYSCALL)
+    return;
+  acquire(&syscall_stats[num].lock);
+  syscall_stats[num].stat.limit++;
+  release(&syscall_stats[num].lock);
+}
+
+int
+get_limit_stat(int syscall_num, int limit)
+{
+  struct proc *p = myproc();
+  struct syscall_stat st;
+
+  if(num <= 0 || num > NSYSCALL)
+    return -1;
+
+  acquire(&syscall_stats[num].lock);
+  st = syscall_stats[num].stat;
+  release(&syscall_stats[num].lock);
+
+  if(st.limit > limit){
+    return -1;
+  }
+  if(copyout(p->pagetable, syscall_name, (char *)&st.name, sizeof(syscall_name)) < 0)
+    return -1;
+  if(copyout(p->pagetable, limit, (char *)&st.limit, sizeof(limit)) < 0)
+    return -1;
+  return 0;
+ 
+}
+
