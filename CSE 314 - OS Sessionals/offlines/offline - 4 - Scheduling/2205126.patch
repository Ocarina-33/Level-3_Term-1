++    print_padded(ps.pid[i], 6);
++    print_padded(ps.inuse[i], 8);
++    print_padded(ps.inQ[i], 6);
++    print_padded(ps.waiting_time[i], 9);
++    print_padded(ps.running_time[i], 9);
++    print_padded(ps.times_scheduled[i], 8);
++    print_padded(ps.tickets_original[i], 7);
++    print_padded(ps.tickets_current[i], 7);
++    print_padded((int)ps.queue_ticks[i][0], 7);
++    print_padded((int)ps.queue_ticks[i][1], 7);
++    printf("\n");
++  }
++
++  exit(0);
++}
