+    acquire(&p->lock);
+    if(p->state == RUNNABLE && p->in_queue == 1){
+      *last_index = (idx + 1) % NPROC;
+      return p; // lock held, caller uses it
+    }
+    release(&p->lock);
+  }
+  return 0;
+}
