++// getpinfo syscall - fills pstat with info for every proc slot
++int
++getpinfo(struct pstat *ps)
++{
++  struct proc *p;
++  struct pstat kps;
++  int i;
++
++  if(ps == 0)
++    return -1;
++
++  memset(&kps, 0, sizeof(kps));
++
++  for(p = proc, i = 0; p < &proc[NPROC]; p++, i++){
++    acquire(&p->lock);
++    kps.pid[i] = p->pid;
++    kps.inuse[i] = (p->state != UNUSED);
++    kps.inQ[i] = p->in_queue;
++    kps.waiting_time[i] = p->wait_ticks;
++    kps.running_time[i] = p->running_time;
++    kps.times_scheduled[i] = p->times_scheduled;
++    kps.tickets_original[i] = p->tickets_original;
++    kps.tickets_current[i] = p->tickets_current;
++    kps.queue_ticks[i][0] = p->queue_ticks[0];
++    kps.queue_ticks[i][1] = p->queue_ticks[1];
++    release(&p->lock);
++  }
++
++  // build locally then copy out once, so we don't hold locks while touching user memory
++  if(copyout(myproc()->pagetable, (uint64)ps, (char *)&kps, sizeof(kps)) < 0)
++    return -1;
++
++  return 0;
++}
