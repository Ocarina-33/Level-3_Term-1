++// settickets syscall - returns -1 and resets to default if number < 1
++int
++settickets(int number)
++{
++  struct proc *p = myproc();
++
++  if(number < 1){
++    acquire(&p->lock);
++    p->tickets_original = DEFAULT_TICKETS;
++    p->tickets_current = DEFAULT_TICKETS;
++    release(&p->lock);
++    return -1;
++  }
++
++  acquire(&p->lock);
++  p->tickets_original = number;
++  p->tickets_current = number;
++  release(&p->lock);
++  return 0;
++}
