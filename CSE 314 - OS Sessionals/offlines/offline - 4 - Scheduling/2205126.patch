+ // Per-CPU process scheduler.
+ // Each CPU calls scheduler() after setting itself up.
+ // Scheduler never returns.  It loops, doing:
+@@ -441,11 +608,17 @@ wait(uint64 addr)
+ //  - swtch to start running that process.
+ //  - eventually that process transfers control
+ //    via swtch back to the scheduler.
++//
++// NOTE: xv6 gives a timer interrupt every tick, so a process can't just
++// "run for 2 ticks" in one swtch() call - it always comes back to us
++// after 1 tick. So we track ticks_in_turn per process and keep picking
++// the same process again until its time slice for that queue is used up.
+ void
+ scheduler(void)
+ {
+   struct proc *p;
+   struct cpu *c = mycpu();
++  static int rr_cursor = 0; // round-robin search position for queue 1
+ 
+   c->proc = 0;
+   for(;;){
+@@ -454,22 +627,56 @@ scheduler(void)
+     // processes are waiting.
+     intr_on();
+ 
+-    for(p = proc; p < &proc[NPROC]; p++) {
+-      acquire(&p->lock);
+-      if(p->state == RUNNABLE) {
+-        // Switch to chosen process.  It is the process's job
+-        // to release its lock and then reacquire it
+-        // before jumping back to us.
+-        p->state = RUNNING;
+-        c->proc = p;
+-        swtch(&c->context, &p->context);
+-
+-        // Process is done running for now.
+-        // It should have changed its p->state before coming back.
+-        c->proc = 0;
++    // aging: promote anyone in queue 1 who's waited too long
++    age_processes();
++
++    // search top-down: queue 0 (lottery) first, then queue 1 (RR)
++    p = pick_lottery_winner();
++    if(p == 0)
++      p = pick_round_robin_winner(&rr_cursor);
++
++    if(p == 0)
++      continue; // nothing runnable
++
++    int queue_before = p->in_queue; // lock is held here
++
++    p->state = RUNNING;
++    p->times_scheduled++;
++    p->wait_ticks = 0;
++    c->proc = p;
++
++    swtch(&c->context, &p->context);
++
++    // back from running one tick (or it gave up the CPU via sleep/exit)
++    c->proc = 0;
++
++    p->queue_ticks[queue_before] += 1;
++    p->ticks_in_turn += 1;
++
++    if(p->state == RUNNABLE){
++      // still runnable -> either its slice is up (demote) or it keeps its turn
++      if(p->ticks_in_turn >= time_limit(queue_before)){
++        p->running_time++;
++        int new_queue = 1; // only 2 queues, so demote always goes to 1
++        if(print_logs)
++          printf(CLR_DEMO "DEMO: Process %d (%s) ran for %d time ticks, demoted to queue %d" CLR_RESET "\n",
++                 p->pid, p->name, p->ticks_in_turn, new_queue);
++        p->in_queue = new_queue;
++        p->ticks_in_turn = 0;
+       }
+-      release(&p->lock);
++      // else: slice not used up yet, leave it in the same queue/turn
++    } else if(p->state == SLEEPING){
++      // gave up CPU voluntarily before slice ran out -> promote
++      int new_queue = 0; // only 2 queues, so promote always goes to 0
++      if(print_logs)
++        printf(CLR_PROMO "PROMO: Process %d (%s) ran for %d time ticks, promoted to queue %d" CLR_RESET "\n",
++               p->pid, p->name, p->ticks_in_turn, new_queue);
++      p->in_queue = new_queue;
++      p->ticks_in_turn = 0;
+     }
++    // if it exited (ZOMBIE), nothing to do here
++
++    release(&p->lock);
+   }
+ }
+ 
+@@ -686,3 +893,59 @@ procdump(void)
+     printf("\n");
+   }
+ }
