++// ---------------- MLFQ helper functions ----------------
++
++// time slice for queue q
++static int
++time_limit(int q)
++{
++  return q == 0 ? TIME_LIMIT_0 : TIME_LIMIT_1;
++}
++
++// bump waiting time for every runnable process, and boost anyone in
++// queue 1 who has waited too long (aging, not priority boost)
++static void
++age_processes(void)
++{
++  struct proc *p;
++
++  for(p = proc; p < &proc[NPROC]; p++){
++    acquire(&p->lock);
++    if(p->state == RUNNABLE){
++      p->wait_ticks++;
++      if(p->in_queue == 1 && p->wait_ticks > WAIT_THRESH){
++        p->in_queue = 0;
++        p->ticks_in_turn = 0;
++        p->wait_ticks = 0;
++        if(print_logs)
++          printf(CLR_BOOST "BOOST: Process %d (%s) waited for %d ticks, promoted to queue 0" CLR_RESET "\n",
++                 p->pid, p->name, WAIT_THRESH);
++      }
++    }
++    release(&p->lock);
++  }
++}
++
++// lottery scheduling for queue 0 (no floats, as per the spec):
++// sum tickets -> refill if everyone is at 0 -> draw r in (0,total]
++// -> walk and find who r lands on. returns winner with lock held.
++static struct proc*
++pick_lottery_winner(void)
++{
++  struct proc *p;
++  int total = 0;
++
++  for(p = proc; p < &proc[NPROC]; p++){
++    acquire(&p->lock);
++    if(p->state == RUNNABLE && p->in_queue == 0)
++      total += p->tickets_current;
++    release(&p->lock);
++  }
++
++  if(total == 0){
++    // everyone spent all their tickets, refill and recompute
++    for(p = proc; p < &proc[NPROC]; p++){
++      acquire(&p->lock);
++      if(p->state == RUNNABLE && p->in_queue == 0){
++        p->tickets_current = p->tickets_original;
++        total += p->tickets_current;
++      }
++      release(&p->lock);
++    }
++  }
++
++  if(total == 0)
++    return 0; // nobody runnable in queue 0
++
++  int r = rand_range_1_to_n(total);
++  int running_sum = 0;
++
++  for(p = proc; p < &proc[NPROC]; p++){
++    acquire(&p->lock);
++    if(p->state == RUNNABLE && p->in_queue == 0){
++      running_sum += p->tickets_current;
++      if(running_sum >= r){
++        p->tickets_current -= 1; // spend a ticket
++        if(print_logs)
++          printf(CLR_LOTTERY "LOTTERY: Process %d (%s) won in queue 0 with tickets %d" CLR_RESET "\n",
++                 p->pid, p->name, p->tickets_current + 1);
++        return p; // lock held, caller uses it
++      }
++    }
++    release(&p->lock);
++  }
++
++  return 0; // shouldn't get here if total > 0
++}
++
++// round robin for queue 1, remembers where it left off so it's fair
++static struct proc*
++pick_round_robin_winner(int *last_index)
++{
++  struct proc *p;
++  int i, start;
++
++  start = *last_index;
++  for(i = 0; i < NPROC; i++){
++    int idx = (start + i) % NPROC;
++    p = &proc[idx];
++    acquire(&p->lock);
++    if(p->state == RUNNABLE && p->in_queue == 1){
++      *last_index = (idx + 1) % NPROC;
++      return p; // lock held, caller uses it
++    }
++    release(&p->lock);
++  }
++  return 0;
++}
