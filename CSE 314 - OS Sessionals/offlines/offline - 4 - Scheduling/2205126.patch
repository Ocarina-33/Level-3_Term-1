diff --git a/user/dummyproc.c b/user/dummyproc.c
new file mode 100644
index 0000000..108e6fc
--- /dev/null
+++ b/user/dummyproc.c
@@ -0,0 +1,74 @@
+// dummyproc <tickets> <iterations>
+// sets tickets, forks a child, both burn CPU for `iterations`.
+// child sleeps periodically so we can see PROMO events too.
+
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+// just busy work, volatile so compiler doesn't optimize it away
+void
+burn(uint64 iterations)
+{
+  volatile uint32 x = 0;
+  uint64 i;
+
+  for(i = 0; i < iterations; i++){
+    x = x * 1103515245 + 12345;
+  }
+}
+
+// same work as burn() but sleeps between chunks (voluntary yield -> PROMO)
+void
+run_child(uint64 iterations)
+{
+  uint64 chunk = iterations / 20 + 1;
+  uint64 done = 0;
+
+  while(done < iterations){
+    uint64 this_chunk = chunk;
+    if(iterations - done < this_chunk)
+      this_chunk = iterations - done;
+    burn(this_chunk);
+    done += this_chunk;
+    sleep(2);
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  int tickets;
+  uint64 iterations;
+  int pid;
+
+  if(argc != 3){
+    fprintf(2, "usage: dummyproc <tickets> <iterations>\n");
+    exit(1);
+  }
+
+  tickets = atoi(argv[1]);
+  iterations = (uint64)atoi(argv[2]);
+
+  if(settickets(tickets) < 0){
+    fprintf(2, "dummyproc: settickets(%d) failed, using default tickets\n", tickets);
+  }
+
+  pid = fork();
+  if(pid < 0){
+    fprintf(2, "dummyproc: fork failed\n");
+    exit(1);
+  }
+
+  if(pid == 0){
+    // child sleeps sometimes, so scheduler should promote it
+    run_child(iterations);
+    exit(0);
+  }
+
+  // parent just burns CPU, never yields on its own
+  burn(iterations);
+
+  wait(0);
+  exit(0);
+}
