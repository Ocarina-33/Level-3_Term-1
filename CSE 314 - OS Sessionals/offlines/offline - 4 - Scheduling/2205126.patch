++// xv6 printf doesn't support %-Nd, so pad manually
++void
++print_padded(int value, int width)
++{
++  int v, digits, printed;
++
++  printf("%d", value);
++
++  v = value;
++  digits = 1;
++  if(v < 0){
++    digits++;
++    v = -v;
++  }
++  while(v >= 10){
++    v /= 10;
++    digits++;
++  }
++
++  for(printed = digits; printed < width; printed++)
++    printf(" ");
++}
++
++int
++main(void)
++{
++  struct pstat ps;
++  int i;
++
++  if(getpinfo(&ps) < 0){
++    fprintf(2, "testprocinfo: getpinfo failed\n");
++    exit(1);
++  }
++
++  printf("PID   In Use  In Q  Waiting  Running  Times   Orig.  Curr.  q0     q1\n");
++  printf("                    time     time     sched.  tix    tix    ticks  ticks\n");
++
++  for(i = 0; i < NPROC; i++){
++    if(ps.pid[i] == 0)
