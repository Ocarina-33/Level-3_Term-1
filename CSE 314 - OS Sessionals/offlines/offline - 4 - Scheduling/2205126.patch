new file mode 100644
index 0000000..13b7c74
--- /dev/null
+++ b/user/testprocinfo.c
@@ -0,0 +1,63 @@
+// testprocinfo: calls getpinfo() and prints a ps-like table
+
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/param.h"
+#include "kernel/pstat.h"
+#include "user/user.h"
+
+
+void
+print_padded(int value, int width)
+{
+  int v, digits, printed;
+
+  printf("%d", value);
+
+  v = value;
+  digits = 1;
+  if(v < 0){
+    digits++;
+    v = -v;
+  }
+  while(v >= 10){
+    v /= 10;
+    digits++;
+  }
+
+  for(printed = digits; printed < width; printed++)
+    printf(" ");
+}
+
+int
+main(void)
+{
+  struct pstat ps;
+  int i;
+
+  if(getpinfo(&ps) < 0){
+    fprintf(2, "testprocinfo: getpinfo failed\n");
+    exit(1);
+  }
+
+  printf("PID   In Use  In Q  Waiting  Running  Times   Orig.  Curr.  q0     q1\n");
+  printf("                    time     time     sched.  tix    tix    ticks  ticks\n");
+
+  for(i = 0; i < NPROC; i++){
+    if(ps.pid[i] == 0)
+      continue; // skip empty slots
+    print_padded(ps.pid[i], 6);
+    print_padded(ps.inuse[i], 8);
+    print_padded(ps.inQ[i], 6);
+    print_padded(ps.waiting_time[i], 9);
+    print_padded(ps.running_time[i], 9);
+    print_padded(ps.times_scheduled[i], 8);
+    print_padded(ps.tickets_original[i], 7);
+    print_padded(ps.tickets_current[i], 7);
+    print_padded((int)ps.queue_ticks[i][0], 7);
+    print_padded((int)ps.queue_ticks[i][1], 7);
+    printf("\n");
+  }
+
+  exit(0);
+}
