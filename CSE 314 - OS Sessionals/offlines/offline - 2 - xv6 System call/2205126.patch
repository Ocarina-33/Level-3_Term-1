+
+// enable tracing for one syscall number, only for this process
+uint64
+sys_trace(void)
+{
+  int num;
+
+  argint(0, &num);
+  if(num <= 0 || num > NSYSCALL)
+    return -1;
+
+  myproc()->trace_syscall = num;
+  return 0;
+}
+
+// return stats for one syscall number into the given struct pointer
+uint64
+sys_history(void)
+{
+  int num;
+  uint64 addr;
+
+  argint(0, &num);
+  argaddr(1, &addr);
+  return get_syscall_stat(num, addr);
+}
