+// one lock per syscall so different syscalls don't block each other
+struct syscall_entry {
+  struct spinlock lock;
+  struct syscall_stat stat;
+};
+struct syscall_entry syscall_stats[NSYSCALL + 1];
+
+// called once from main.c at boot
+void
+syscallstatinit(void)
+{
+  for(int i = 1; i <= NSYSCALL; i++){
+    initlock(&syscall_stats[i].lock, "syscallstat");
+    safestrcpy(syscall_stats[i].stat.syscall_name, syscall_names[i],
+               sizeof(syscall_stats[i].stat.syscall_name));
+    syscall_stats[i].stat.count = 0;
+    syscall_stats[i].stat.accum_time = 0;
+  }
+}
+
+static void
+record_syscall_stat(int num, int elapsed)
+{
+  if(num <= 0 || num > NSYSCALL)
+    return;
+  acquire(&syscall_stats[num].lock);
+  syscall_stats[num].stat.count++;
+  syscall_stats[num].stat.accum_time += elapsed;
+  release(&syscall_stats[num].lock);
+}
+
+// copies stats for syscall num to user struct syscall_stat* at addr
+int
+get_syscall_stat(int num, uint64 addr)
+{
+  struct proc *p = myproc();
+  struct syscall_stat st;
+
+  if(num <= 0 || num > NSYSCALL)
+    return -1;
+
+  acquire(&syscall_stats[num].lock);
+  st = syscall_stats[num].stat;
+  release(&syscall_stats[num].lock);
+
+  if(copyout(p->pagetable, addr, (char *)&st, sizeof(st)) < 0)
+    return -1;
+  return 0;
+}
+
+// holds a copy of a syscall's args, taken before the handler runs.
+// needed because a0 gets overwritten with the return value, and exec
+// frees the old pagetable so its path string wouldn't be readable
+// anymore after the call
+struct syscall_argsnap {
+  uint64 raw[6];
+  char strbuf[3][128];
+};
+
+static void
+snapshot_args(struct proc *p, int num, struct syscall_argsnap *snap)
+{
+  char *fmt = syscall_argfmt[num];
+
+  snap->raw[0] = p->trapframe->a0;
+  snap->raw[1] = p->trapframe->a1;
+  snap->raw[2] = p->trapframe->a2;
+  snap->raw[3] = p->trapframe->a3;
+  snap->raw[4] = p->trapframe->a4;
+  snap->raw[5] = p->trapframe->a5;
+
+  for(int i = 0; fmt[i] && i < 3; i++){
+    if(fmt[i] == 's'){
+      if(fetchstr(snap->raw[i], snap->strbuf[i], sizeof(snap->strbuf[i])) < 0)
+        snap->strbuf[i][0] = 0;
+    }
+  }
+}
+
+static void
+print_trace(struct proc *p, int num, uint64 ret, struct syscall_argsnap *snap)
+{
+  char *fmt = syscall_argfmt[num];
+
+  printf("pid: %d, syscall: %s, args: (", p->pid, syscall_names[num]);
+  for(int i = 0; fmt[i]; i++){
+    if(i > 0)
+      printf(", ");
+    if(fmt[i] == 'i')
+      printf("%d", (int)snap->raw[i]);
+    else if(fmt[i] == 'p')
+      printf("%p", (void*)snap->raw[i]);
+    else if(fmt[i] == 's')
+      printf("%s", snap->strbuf[i]);
+  }
+  printf("), return: %d\n", (int)ret);
+}
